import express from "express";
const app = express();
const PORT = 3000;

app.get('/', (req, res) => {
    res.send('<h1>Bem-vindo ao nosso servidor Express!</h1><p>Esta é a página inicial.</p>');
});


app.get('/sobre', (req, res) => {
    res.send('<h1>Sobre Nós</h1><p>Somos uma empresa focada em criar soluções web modernas e eficientes.</p>');
});

app.listen(PORT, () => {
    console.log(`Servidor rodando com sucesso em http://localhost:${PORT}`);
});
